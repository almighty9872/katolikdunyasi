# OS / editor files
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Temporary build output used by the GitHub Actions workflow
_site/

# Everything tools/build.ps1 writes: the deploy builds it fresh from data/ and content/
/*.html
/en/
/kilise/
/sitemap.xml
/robots.txt
/llms.txt
/[0-9a-f]*.txt
/.well-known/
/assets/*.min.css
/assets/*.min.js
/data/azizler-adlar.js
/data/azizler-ozet-*.js
# the WebP and AVIF copies of the paintings: the deploy makes them from the JPEGs
/assets/art/*.webp
/assets/art/*.avif
/assets/art/tl/s/*.webp
/assets/art/tl/s/*.avif


__pycache__/
.wrangler/

# The English site's own build (verbumdomini/tools/build.ps1) writes the same things inside verbumdomini/
/verbumdomini/*.html
/verbumdomini/en/
/verbumdomini/kilise/
/verbumdomini/sitemap.xml
/verbumdomini/robots.txt
/verbumdomini/llms.txt
/verbumdomini/[0-9a-f]*.txt
/verbumdomini/.well-known/
/verbumdomini/assets/*.min.css
/verbumdomini/assets/*.min.js
/verbumdomini/data/azizler-adlar.js
/verbumdomini/data/azizler-ozet-*.js
/verbumdomini/assets/art/*.webp
/verbumdomini/assets/art/*.avif
/verbumdomini/_site_en/

# the 3D beads build tool (tools/rosary3d/README.md); its output, assets/vendor/rosary3d.js, is kept
tools/rosary3d/node_modules/
